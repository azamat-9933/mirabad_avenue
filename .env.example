# Copy to .env. Values below are for local development.

# Django
# Production requires DEBUG=False (the default when unset) and a long random SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS (production only; all optional)
# Session/CSRF cookies are HTTPS-only unless DEBUG=True. Set False only for a plain-HTTP deployment.
# SECURE_COOKIES=True
# Public origins that submit forms, needed when TLS ends at a proxy, e.g. https://billing.example.uz
# CSRF_TRUSTED_ORIGINS=
# True only behind a proxy (nginx) that sets X-Forwarded-Proto itself.
# USE_X_FORWARDED_PROTO=False
# True only behind a proxy (nginx) that appends X-Forwarded-For, so the activity log records client IPs.
# TRUST_X_FORWARDED_FOR=False
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0

# Database (leave DB_ENGINE empty to use local SQLite: db.sqlite3)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=billing_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me

# CORS (only for a separate frontend on another origin; empty by default)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
